---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IntegrationGrid from '@/components/IntegrationGrid.astro';
import { withBase } from '@/data/site';
---
<BaseLayout title="AI assistant integrations for WordPress — SiteRadian" description="Connect Codex, Claude, Gemini, Cursor, Continue, GitHub Copilot, OpenCode, Command Code, Muse Code, and other supported clients to WordPress safely.">
  <header class="page-hero"><div class="container narrow"><p class="eyebrow">Integrations</p><h1>Use the assistant you already trust.</h1><p class="lede">Each client receives setup shaped for its real configuration model. Every one reaches the same governed SiteRadian operation surface.</p></div></header>
  <section class="section"><div class="container"><div class="section-header"><div><p class="eyebrow">12 client guides</p><h2>Choose your exact application.</h2><p>Desktop, terminal, and editor clients can use different files, root keys, and credential behavior—even under the same vendor.</p></div></div><IntegrationGrid /></div></section>
  <section class="section soft"><div class="container split"><div><p class="eyebrow">Two connection paths</p><h2 class="content-heading">Direct when supported. A small local connector when required.</h2><p><strong>Direct HTTP</strong> clients connect straight to your site over HTTPS. <strong>Local connector</strong> clients run a small script served by your own SiteRadian installation and need Node.js on the assistant’s computer.</p><p>No client gets a separate WordPress runtime or different governance rules.</p></div><div class="boundary-card"><p class="eyebrow">Start safely</p><h3>Read first. Expand later.</h3><ul><li>Create a Read-only token.</li><li>Use the generated setup from your own site.</li><li>Run <code>system_info</code> once.</li><li>Grant write capabilities only when the task needs them.</li></ul></div></div></section>
  <section class="section"><div class="container availability"><div class="availability-inner"><div><p class="eyebrow">Need a clean first run?</p><h2>Follow the ten-step beginner path.</h2><p>Installation, scoped access, connection, verification, approval, changes, and rollback—without assuming you already know MCP.</p></div><a class="button" href={withBase('/docs/getting-started/')}>Open Getting Started</a></div></div></section>
</BaseLayout>
