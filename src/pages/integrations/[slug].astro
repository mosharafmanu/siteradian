---
import DocsLayout from '@/layouts/DocsLayout.astro';
import StillNeedHelp from '@/components/StillNeedHelp.astro';
import AdminAccessNote from '@/components/AdminAccessNote.astro';
import { integrations, type Integration } from '@/data/integrations';
import { withBase } from '@/data/site';

export function getStaticPaths() {
  return integrations.map(integration => ({ params: { slug: integration.slug }, props: { integration } }));
}
interface Props { integration: Integration }
const { integration } = Astro.props;
---
<DocsLayout title={'Connect ' + integration.name + ' to WordPress'} description={integration.intro + ' Follow the SiteRadian 1.0.0 setup, verification, troubleshooting, and security guidance.'} section="integrations" updated="14 September 2026">
  <div class="docs-content">
    <section>
      <div class="integration-identity"><span class="integration-icon"><img src={withBase('/integrations/' + integration.icon)} width="30" height="30" alt="" /></span><div><strong>{integration.name}</strong><p>{integration.vendor} · {integration.status}</p></div></div>
      <div class="meta-grid"><div><span>Client type</span><strong>{integration.type}</strong></div><div><span>Connection</span><strong>{integration.transport}</strong></div><div><span>Configuration</span><strong>{integration.settings}</strong></div></div>
      {integration.note && <aside class="callout warning"><strong>Important</strong>{integration.note}</aside>}
      <AdminAccessNote />
    </section>
    <section><h2>What you need</h2><ul>{integration.prerequisites.map(item => <li>{item}</li>)}</ul></section>
    <section><h2>Set up the connection</h2><ol>{integration.steps.map(item => <li>{item}</li>)}</ol>{integration.code && <><p class="callout"><strong>Safe example</strong>Replace the example site and token with values generated by your own SiteRadian screen. Never publish the completed command.</p><pre data-language={integration.language}><code>{integration.code}</code></pre></>}</section>
    <section><h2>Restart and verify</h2><p>{integration.restart}</p><pre><code>Run the SiteRadian system_info tool once. Read only; do not change anything.</code></pre><p>Compare the returned WordPress, PHP, database, theme, and site information with the site you intended to connect.</p></section>
    <section><h2>Troubleshooting</h2><ul>{integration.troubleshooting.map(item => <li>{item}</li>)}</ul><p>For shared connection checks, see <a href={withBase('/docs/troubleshooting/')}>SiteRadian troubleshooting</a>.</p></section>
    <section><h2>Security notes</h2><ul>{integration.security.map(item => <li>{item}</li>)}</ul><p>Start Read-only, grant the narrowest required capabilities, and revoke credentials that are no longer needed.</p></section>
    <section><h2>Next step</h2><p>Once the read-only check succeeds, learn how <a href={withBase('/docs/protection/')}>protection modes</a> and <a href={withBase('/docs/approvals/')}>human approval</a> govern changes.</p></section>
    <StillNeedHelp client={integration.name} />
  </div>
</DocsLayout>
