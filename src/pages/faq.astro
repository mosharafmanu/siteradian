---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/data/site';
const faqs = [
  ['Does SiteRadian include AI?', 'No. SiteRadian is a governance and operations layer around external assistants. Optional Built-in AI features can use a provider key you supply, but they are separate and off by default.'],
  ['Do I need an OpenAI or Anthropic API key?', 'Not for an MCP connection. The assistant uses its own model and account. A provider API key is needed only if you choose an optional Built-in AI feature inside SiteRadian.'],
  ['Which assistants work?', 'SiteRadian includes guided setup for Codex in ChatGPT Desktop, Codex CLI, Claude Desktop, Claude Code, Antigravity CLI, Gemini CLI, Cursor, Continue for VS Code, GitHub Copilot in VS Code, OpenCode, Command Code, and Muse Code.'],
  ['Does SiteRadian store my AI credentials?', 'MCP assistant credentials are SiteRadian access tokens, not provider API keys. SiteRadian reveals each token once and stores only its hash. Optional Built-in AI provider keys are stored separately on your own WordPress site.'],
  ['Does SiteRadian require SSH, FTP, or SFTP?', 'No for the supported WordPress operations SiteRadian performs through WordPress. Your account must be allowed to install and activate the plugin, and the connected credential must have the required SiteRadian scope and WordPress permissions. Hosting- or server-level tasks may still require SSH, SFTP, a hosting control panel, database access, or provider tooling.'],
  ['Does SiteRadian replace SSH or SFTP?', 'No. SiteRadian provides a governed path for its supported WordPress operations; it does not provide complete server access. Operating-system administration, hosting configuration, infrastructure changes, file work outside supported operations, and recovery when WordPress itself is unavailable remain separate responsibilities.'],
  ['What is scoped access?', 'A token is Read-only or Full and can be narrowed with named capabilities. Read-only is enforced before dispatch, so approval settings cannot turn it into write access.'],
  ['When is approval required?', 'Standard protection gates medium-, high-, and critical-risk changes. Strict approval gates every write. Diagnostic reads remain immediate.'],
  ['Can I undo changes?', 'Supported changes can be undone from Changes. Undo is governed like any other change, and fields modified later are skipped rather than overwritten. Some operations are not reversible, and SiteRadian labels those limits.'],
  ['Does it work with WooCommerce?', 'Yes. The operation surface includes products, inventory, pricing, categories, variations, orders, customers, coupons, and reporting. Rollback availability depends on the exact action; WooCommerce orders are not automatically undoable.'],
  ['What does Development mode do?', 'It removes the approval step for operations that pass scope and capability checks. It is for local and staging sites only and is never the default.'],
  ['Why does Codex say SITERADIAN_TOKEN is missing?', 'The MCP registration persists, but a terminal export belongs only to that terminal session. Export a valid token again and start Codex in that same terminal. Do not recreate the registration if codex mcp list already shows siteradian.'],
  ['Does SiteRadian modify my assistant config automatically?', 'Only through the native setup action you explicitly run. SiteRadian does not silently rewrite local files. File-based instructions tell you to merge the SiteRadian entry and preserve unrelated settings.'],
  ['Is SiteRadian free?', 'SiteRadian 1.0.0 is prepared as a free, GPL-licensed WordPress.org plugin. Its directory submission is currently awaiting review.'],
  ['Is there a Pro version?', 'No paid edition or pricing has been announced. Future product plans will be documented only when they are concrete.'],
];
const schema = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faqs.map(([q,a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) };
---
<BaseLayout title="SiteRadian FAQ — WordPress AI access without server credentials" description="Answers about SiteRadian, WordPress Admin access, SSH and SFTP requirements, assistant connections, scoped tokens, approvals, rollback, WooCommerce, and security." schema={schema}>
  <header class="page-hero"><div class="container narrow"><p class="eyebrow">FAQ</p><h1>Straight answers before access.</h1><p class="lede">SiteRadian is the control layer between an assistant and WordPress—not an AI model, hosted agent, or unrestricted administrator account.</p></div></header>
  <section class="section"><div class="container"><div class="faq-list">{faqs.map(([question,answer]) => <details><summary>{question}</summary><div>{answer}</div></details>)}</div></div></section>
  <section class="section soft"><div class="container availability"><div class="availability-inner"><div><p class="eyebrow">Still looking?</p><h2>Search the documentation.</h2><p>Search installation, protection, approvals, rollback, troubleshooting, and all 12 client tutorials without a third-party search service.</p></div><a class="button" href={withBase('/search/')}>Search docs</a></div></div></section>
</BaseLayout>
