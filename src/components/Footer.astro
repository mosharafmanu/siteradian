---
import { siteConfig, supportLinks, withBase } from '@/data/site';
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src={withBase('/brand/siteradian-logo-dark.svg')} width="178" height="42" alt="SiteRadian" loading="lazy" />
      <p>{siteConfig.descriptor}</p>
      <span class="version">Version {siteConfig.version} · WordPress.org review pending</span>
    </div>
    <div>
      <h2>Product</h2>
      <a href={withBase('/how-it-works/')}>How it works</a>
      <a href={withBase('/integrations/')}>Integrations</a>
      <a href={withBase('/security/')}>Security</a>
      <a href={withBase('/faq/')}>FAQ</a>
    </div>
    <div>
      <h2>Resources</h2>
      <a href={withBase('/docs/')}>Documentation</a>
      <a href={withBase('/docs/getting-started/')}>Getting started</a>
      <a href={supportLinks.troubleshooting}>Troubleshooting</a>
      <a href={supportLinks.center}>Support</a>
    </div>
    <div>
      <h2>Developers</h2>
      <a href={siteConfig.repository}>GitHub</a>
      <a href={supportLinks.bug}>Report a bug</a>
      <a href={supportLinks.feature}>Request a feature</a>
      <a href={supportLinks.privateSecurityReport}>Report a vulnerability</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>Product names and logos belong to their respective owners. SiteRadian is not affiliated with or endorsed by those vendors.</p>
    <p class="footer-legal"><a href={withBase('/privacy/')}>Privacy</a><a href={withBase('/terms/')}>Terms</a><a href={withBase('/attributions/')}>Attributions</a><span>© {new Date().getFullYear()} SiteRadian.</span></p>
  </div>
</footer>
